<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup & device-transfer rules (Android 12+). Only app preferences (theme,
  week start, widget look…) are eligible; no calendar or task data is stored
  by こよみ itself, so there is nothing sensitive to exclude.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
