      こよみ brand mark (壱・日めくり), monochrome edition: a solid black
      tear-off page on white, a hairline cut where the header band would be,
      two binding rings, and a bold white "1". Safe zone 24..84.
    -->
    <!-- Page (墨) -->
    <path
        android:fillColor="#111111"
        android:pathData="M39,30h30a7,7 0 0 1 7,7v36a7,7 0 0 1 -7,7h-30a7,7 0 0 1 -7,-7v-36a7,7 0 0 1 7,-7z" />
    <!-- Hairline separating the header band -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,43h44v1.5h-44z" />
    <!-- Binding rings: the arcs above the page read black on white -->
    <path
        android:strokeColor="#111111"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M41,35v-5a4,4 0 0 1 8,0v5" />
    <path
        android:strokeColor="#111111"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M59,35v-5a4,4 0 0 1 8,0v5" />
    <!-- Ring holes punched through the page -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,34m-2,0a2,2 0 1 1 4,0a2,2 0 1 1 -4,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M63,34m-2,0a2,2 0 1 1 4,0a2,2 0 1 1 -4,0" />
    <!-- The day numeral "1" (paper white) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M59,50h-6.5l-8.5,6.5v6.5l6.5,-4.5v17.5h8.5z" />
