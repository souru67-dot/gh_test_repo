<?xml version="1.0" encoding="utf-8"?>
<!--
  Dot-matrix clock. A TextClock ticks on its own (no widget redraws), drawn
  in the round-dot Doto face; an "88 88" ghost underneath shows the unlit
  dots like a real LED panel. Doto's digits are monospaced, so the ghost
  lines up exactly with the live digits.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/dot_clock_ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_dot"
        android:includeFontPadding="false"
        android:text="88 88"
        android:textColor="@color/dot_ghost"
        android:textSize="48sp" />

    <TextClock
        android:id="@+id/dot_clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_dot"
        android:format12Hour="hh mm"
        android:format24Hour="HH mm"
        android:includeFontPadding="false"
        android:textColor="@color/dot_lit"
        android:textSize="48sp" />
</FrameLayout>
