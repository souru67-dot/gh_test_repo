<?xml version="1.0" encoding="utf-8"?>
<!-- "11/23 MON" + dot weather icon, high/low and (rainy days) rain chance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/dot_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/doto_dot"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/dot_lit"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/dot_wx"
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_marginStart="9dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dot_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="@font/doto_dot"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/dot_lit"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/dot_rain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:alpha="0.75"
        android:fontFamily="@font/doto_dot"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/dot_lit"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
